# ============================================================
# CodeSants CRM · variáveis de ambiente
# Copie para .env.local. Nenhuma delas é obrigatória para rodar:
# sem Supabase, o CRM sobe com dados de exemplo.
# ============================================================

# ---- Supabase (fase 2) -------------------------------------
# Provisione pela Vercel (`vercel integration add supabase`) e rode
# supabase/schema.sql. Quando as DUAS existirem, o CRM passa a gravar de
# verdade — nenhuma linha de código muda.
#
# ATENÇÃO: a service role key ignora RLS. Ela é só de servidor, nunca
# pode receber o prefixo NEXT_PUBLIC_ nem aparecer em componente de cliente.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Ingestão vinda do formulário --------------------------
# Origens autorizadas a chamar POST /api/diagnosticos, separadas por vírgula.
# Em branco usa o padrão: forms-codesants.vercel.app e localhost.
CRM_ALLOWED_ORIGINS=

# Token compartilhado opcional. Se preenchido, o formulário precisa enviar o
# mesmo valor no cabeçalho X-Ingest-Token (constante CRM_TOKEN no index.html).
# O formulário é uma página pública, então isto corta ruído automatizado —
# não é um segredo de verdade.
CRM_INGEST_TOKEN=
