# ============================================================
# CodeSants CRM · variáveis de ambiente
# Copie para .env.local. Nenhuma delas é obrigatória para rodar:
# sem Supabase, o CRM sobe com dados de exemplo.
# ============================================================

# ---- Supabase ----------------------------------------------
# Quando as DUAS existirem, o CRM passa a gravar de verdade — nenhuma linha
# de código muda. Rode supabase/schema.sql antes do primeiro envio.
#
# SUPABASE_URL é o nome preferido (só o servidor usa). O código também aceita
# NEXT_PUBLIC_SUPABASE_URL, que é o nome injetado pela integração da Vercel.
SUPABASE_URL=https://mwqbafwowttuqbevacde.supabase.co
#
# ATENÇÃO: a service role key ignora RLS. Ela é só de servidor, nunca
# pode receber o prefixo NEXT_PUBLIC_ nem aparecer em componente de cliente.
# Pegue em: Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---- Ingestão vinda do formulário --------------------------
# Origens autorizadas a chamar a API, separadas por vírgula. Em branco usa o
# padrão do código (forms.codesants.com.br, o domínio .vercel.app e localhost).
# O domínio de PRODUÇÃO do formulário é forms.codesants.com.br — se ele mudar,
# atualize aqui, senão o navegador bloqueia o envio.
CRM_ALLOWED_ORIGINS=https://forms.codesants.com.br,https://forms-codesants.vercel.app,http://localhost:3000,http://localhost:5500

# Token compartilhado opcional. Se preenchido, o formulário precisa enviar o
# mesmo valor no cabeçalho X-Ingest-Token (constante CRM_TOKEN no index.html).
# O formulário é uma página pública, então isto corta ruído automatizado —
# não é um segredo de verdade.
CRM_INGEST_TOKEN=
